# Copia in .env.local e compila con i valori del tuo progetto Supabase
# (Supabase → Project Settings → API Keys). Su Vercel vanno in Settings → Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Segreta: solo sul server, non va mai condivisa né messa su GitHub.
SUPABASE_SECRET_KEY=sb_secret_...
